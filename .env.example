# ============================================================================
# 内部部署环境变量样例：复制为 .env 后按需修改（.env 已被 .gitignore 排除，
# 账密/密钥绝不硬编码进代码、绝不提交进Git）。
#   cp .env.example .env && 编辑 .env
# ============================================================================

# ---- PostgreSQL（docker-compose 的 db 服务） ----
POSTGRES_USER=ceb
# 必改：数据库口令（生成示例：python -c "import secrets;print(secrets.token_urlsafe(16))"）
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=ceb_verify

# ---- 登录会话 ----
# 必改：JWT签名密钥（同上方式生成随机值；更换后所有已发令牌失效，需重新登录）
AUTH_SECRET_KEY=change-me-to-a-long-random-secret
# 令牌有效期（小时），网页/App通用；默认12小时
AUTH_TOKEN_EXPIRE_HOURS=12

# ---- 首次启动种子账号（users表为空时创建；留空则生成随机密码打印到容器日志一次） ----
ADMIN_INITIAL_PASSWORD=
BUSINESS_INITIAL_PASSWORD=
FINANCE_INITIAL_PASSWORD=

# ---- 网络/时区 ----
# 局域网发布端口（内部服务器防火墙只放行内网网段访问）
APP_API_PORT=8000
APP_WEB_PORT=8501
# 批次/日志时间的展示时区
BUSINESS_TIMEZONE=Asia/Shanghai

# ---- 大模型（可选：整改邮件/对话助手；不配则以离线模板运行） ----
# ARK_API_KEY=
# GLM_API_KEY=
